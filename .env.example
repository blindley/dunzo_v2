# Copy to .env and adjust. .env is gitignored; this file is committed.
# Port the server listens on (required)
PORT=8000

# Interface to bind (default: 127.0.0.1). Keep it on loopback unless you know why.
# HOST=127.0.0.1

# Where application data is stored (default: ./data, relative to the project root)
# DATA_DIR=data

# Largest media upload in bytes (default: 20971520 = 20 MB)
# MAX_MEDIA_BYTES=20971520

# IANA time zone used for study days, e.g. Europe/Berlin (default: the system time zone)
# TIMEZONE=
